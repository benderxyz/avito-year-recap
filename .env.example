# ClickHouse (analytics-service)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=recap
CLICKHOUSE_DATABASE=default

# analytics-service: SERVER_PORT=8080
# user-service: SERVER_PORT=8082
SERVER_PORT=8080
MIGRATIONS_DIR=migrations

# Shared Postgres host (one container, databases cards and users)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=recap
POSTGRES_PASSWORD=recap
POSTGRES_SSLMODE=disable

# Do not set POSTGRES_DATABASE here.
# cards-service defaults to cards, user-service defaults to users.

# cards-service and analytics-service
USER_SERVICE_URL=http://localhost:8082

# cards-service
PORT=8081
ANALYTICS_SERVICE_URL=http://localhost:8080
SHARE_SIGNING_KEY=dev-insecure-share-key
SHARE_BASE_URL=http://localhost:3000
PRODUCT_BASE_URL=https://www.avito.ru
SEEDS_DIR=seeds
SEED_ON_START=false

# LLM (cards-service, optional — off by default)
# When LLM_ENABLED=true and OPENAI_API_KEY is set, cards-service rewrites badge
# copy and adds a personality "insight" story scene. If disabled or unavailable,
# the base recap is served unchanged.
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=4000