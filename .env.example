# ClickHouse (analytics-service)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=recap
CLICKHOUSE_DATABASE=default

# analytics-service: SERVER_PORT=8080
# user-service: SERVER_PORT=8082
SERVER_PORT=8080
MIGRATIONS_DIR=migrations

# Shared Postgres host (one container, databases cards, users and analytics)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=recap
POSTGRES_PASSWORD=recap
POSTGRES_SSLMODE=disable

# Do not set POSTGRES_DATABASE here.
# cards-service defaults to cards, user-service to users, analytics-service to analytics.

# analytics-service event registry (Postgres)
PG_MIGRATIONS_DIR=migrations-pg
PG_SEEDS_DIR=seeds
REGISTRY_CACHE_TTL_SECONDS=60

# cards-service and analytics-service
USER_SERVICE_URL=http://localhost:8082

# cards-service
PORT=8081
ANALYTICS_SERVICE_URL=http://localhost:8080
SHARE_SIGNING_KEY=dev-insecure-share-key
SHARE_BASE_URL=http://localhost:3000
PRODUCT_BASE_URL=https://www.avito.ru
SEEDS_DIR=seeds
SEED_ON_START=true

ADMIN_API_TOKEN=dev-insecure-admin-token

# LLM (cards-service, optional — off by default)
# When LLM_ENABLED=true and OPENAI_API_KEY is set, cards-service rewrites badge
# copy and adds a personality "insight" story scene. If disabled or unavailable,
# the base recap is served unchanged.
#
# Canonical provider is OpenRouter (OpenAI-compatible endpoint). OPENAI_API_KEY
# holds the OpenRouter key (sk-or-v1-...). Swap LLM_BASE_URL/LLM_MODEL to target
# OpenAI directly if needed.
LLM_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemma-2-9b-it:free
LLM_TIMEOUT_MS=30000