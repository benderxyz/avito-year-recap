{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recap",
  "type": "object",
  "required": ["profile_id", "cards"],
  "properties": {
    "profile_id": { "type": "string" },
    "cards": {
      "type": "array",
      "items": { "$ref": "#/definitions/Card" }
    }
  },
  "definitions": {
    "Card": {
      "type": "object",
      "required": ["type", "title", "text"],
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "action": { "type": "string" },
        "action_value": { "type": "string" }
      }
    }
  }
}
