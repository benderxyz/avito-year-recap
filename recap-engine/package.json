{
  "name": "recap-engine",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @recap-engine/core --filter @recap-engine/react run build",
    "docs:start": "pnpm --filter @recap-engine/docs start",
    "docs:build": "pnpm --filter @recap-engine/docs build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check .",
    "lintfix": "biome check . --write",
    "typecheck": "pnpm --filter @recap-engine/core run build && pnpm -r run typecheck",
    "prepare": "cd .. && husky .husky"
  },
  "lint-staged": {
    "*": "biome check --write --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@jest/globals": "^30.4.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.3.0",
    "netlify-cli": "^27.1.0"
  },
  "pnpm": {
    "overrides": {
      "human-id": "4.1.3"
    }
  }
}
